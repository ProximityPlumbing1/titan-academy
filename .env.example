# Local dev: copy to .env (or export). On Railway these are service variables. Never commit real values.
DATABASE_URL=postgres://postgres@127.0.0.1:55432/titan_test
SESSION_SECRET=change-me-long-random
PUBLIC_URL=http://localhost:3000
TZ=Australia/Sydney
NODE_ENV=development
# One-time code for /setup (first admin password). /setup switches off once an admin has a password.
ADMIN_SETUP_CODE=
# Seeds the owner's email on the William account.
OWNER_EMAIL=
# Later: email invites (same pattern as sales-pro; ask the owner before copying values)
GMAIL_SENDER=
GOOGLE_SA_JSON=
