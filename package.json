{
  "name": "titan-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Proximity Plumbing Titan Academy: field team training with tech logins, desktop admin and live TV classes",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.json && vite build && node scripts/compress.mjs",
    "migrate": "node dist/server/migrate.js",
    "start": "node dist/server/index.js",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node tests/live-class.e2e.mjs",
    "e2e:program": "node tests/program-signoffs.e2e.mjs",
    "e2e:certificates": "node tests/certificates.e2e.mjs",
    "e2e:gaps": "node tests/gaps.e2e.mjs",
    "audit:a11y": "node tests/a11y.mjs",
    "e2e:offline": "node tests/offline.e2e.mjs",
    "e2e:team": "node tests/team.e2e.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "fastify": "^5.12.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
